# Ye pattern dhundhega: repo/node_modules, repo/project1/node_modules, repo/project2/backend/node_modules, etc.
**/node_modules/
**/bower_components/
**/jspm_packages/
**/.venv/
**/venv/
**/env/

# ==========================================
# ENVIRONMENT & SECRETS (Very Important)
# ==========================================
# Ye kisi bhi level par .env, .env.local, .env.production sabko ignore karega
**/.env
**/.env.*
!**/.env.example

# ==========================================
# BUILD OUTPUTS & DIST
# ==========================================
**/dist/
**/build/
**/out/
**/coverage/
**/*.tsbuildinfo

# ==========================================
# LOGS & DEBUG
# ==========================================
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ==========================================
# OS & IDE FILES
# ==========================================
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/*.swp

# ==========================================
# CACHE & TEMPORARY
# ==========================================
**/.cache/
**/.next/
**/.nuxt/
**/.turbo/
**/.parcel-cache/
**/tmp/
**/temp/